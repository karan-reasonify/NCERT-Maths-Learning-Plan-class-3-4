# Template only - copy to .env at this pipeline's root and fill in real values.
# .env is gitignored. core/config.py reads it; nothing else in the pipeline reads
# it directly. Bare KEY=value lines, no quotes needed unless a value has spaces.

# Postgres connection string for the lpv2 tables (lp2_plans / lp2_plan_blobs /
# lp2_chapters). Required by core/check_master_id.py, upload/verify_uploaded.py,
# and core/config.py's own doctor (`python core/config.py`). Not required to
# build or validate a plan - only to read the database back.
#   postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional. Which table set core/config.py targets: "lpv2" (default, writable)
# or "lpv1" (the superseded store, read only). Leave unset unless you have a
# specific reason to point a read-only check at lpv1.
#LP_DESTINATION=lpv2

# Optional. Seconds before a database connection attempt times out. Defaults
# to 15 if unset.
#DB_CONNECT_TIMEOUT=15
